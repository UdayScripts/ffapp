rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && (
          request.auth.token.email == 'udaynath381@gmail.com' ||
          request.auth.token.email == 'uday@esportsarena.app'
        )) ||
        request.auth.uid == 'admin_uday_master' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidTournament(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 64)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('matchType' in data) || (data.matchType is string && data.matchType.size() <= 30)) &&
             (!('map' in data) || (data.map is string && data.map.size() <= 50)) &&
             (!('entryFee' in data) || (data.entryFee is number && data.entryFee >= 0)) &&
             (!('prizePool' in data) || (data.prizePool is number && data.prizePool >= 0)) &&
             (!('maxSlots' in data) || (data.maxSlots is number && data.maxSlots > 0)) &&
             (!('joinedSlots' in data) || (data.joinedSlots is number && data.joinedSlots >= 0)) &&
             (!('perKillReward' in data) || data.perKillReward is number) &&
             (!('perKill' in data) || data.perKill is number) &&
             (!('roomId' in data) || data.roomId == null || (data.roomId is string && data.roomId.size() <= 50)) &&
             (!('roomPassword' in data) || data.roomPassword == null || (data.roomPassword is string && data.roomPassword.size() <= 50)) &&
             (!('roomNotice' in data) || data.roomNotice == null || (data.roomNotice is string && data.roomNotice.size() <= 200)) &&
             (!('scheduleTime' in data) || (data.scheduleTime is string && data.scheduleTime.size() <= 50)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 30)) &&
             (!('firstPrize' in data) || data.firstPrize is number) &&
             (!('secondPrize' in data) || data.secondPrize is number) &&
             (!('thirdPrize' in data) || data.thirdPrize is number) &&
             (!('rules' in data) || (data.rules is string && data.rules.size() <= 2000)) &&
             (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() <= 128)) &&
             (!('timestamp' in data) || data.timestamp is number || data.timestamp is timestamp) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidUserProfile(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
             (!('usernameLower' in data) || (data.usernameLower is string && data.usernameLower.size() <= 100)) &&
             (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 256)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('ffIgn' in data) || (data.ffIgn is string && data.ffIgn.size() <= 50)) &&
             (!('ffUid' in data) || (data.ffUid is string && data.ffUid.size() <= 50)) &&
             (!('inGameName' in data) || (data.inGameName is string && data.inGameName.size() <= 50)) &&
             (!('inGameId' in data) || (data.inGameId is string && data.inGameId.size() <= 50)) &&
             (!('walletBalance' in data) || data.walletBalance is number) &&
             (!('winningBalance' in data) || data.winningBalance == null || data.winningBalance is number) &&
             (!('totalWithdrawn' in data) || data.totalWithdrawn is number) &&
             (!('balance' in data) || data.balance is number) &&
             (!('isAdmin' in data) || data.isAdmin is bool) &&
             (!('isSuspended' in data) || data.isSuspended is bool) &&
             (!('matchesPlayed' in data) || data.matchesPlayed is number) &&
             (!('totalKills' in data) || data.totalKills is number) &&
             (!('totalWinnings' in data) || data.totalWinnings is number) &&
             (!('bonusClaimed' in data) || data.bonusClaimed is bool) &&
             (!('savedUpiId' in data) || (data.savedUpiId is string && data.savedUpiId.size() <= 100)) &&
             (!('signupTimestamp' in data) || data.signupTimestamp is number) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidParticipant(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('tournamentId' in data) || (data.tournamentId is string && data.tournamentId.size() <= 64)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('playerName' in data) || (data.playerName is string && data.playerName.size() <= 50)) &&
             (!('ffIgn' in data) || (data.ffIgn is string && data.ffIgn.size() <= 50)) &&
             (!('ffUid' in data) || (data.ffUid is string && data.ffUid.size() <= 50)) &&
             (!('slotNumber' in data) || data.slotNumber is number) &&
             (!('kills' in data) || data.kills is number) &&
             (!('placement' in data) || data.placement is number) &&
             (!('prizeWon' in data) || data.prizeWon is number) &&
             (!('joinedAt' in data) || data.joinedAt is number || data.joinedAt is timestamp);
    }

    function isValidTransaction(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 30)) &&
             (!('amount' in data) || data.amount is number) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 200)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 30)) &&
             (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 100)) &&
             (!('timestamp' in data) || data.timestamp is number || data.timestamp is timestamp) &&
             (!('balanceAfter' in data) || data.balanceAfter is number);
    }

    function isValidNotification(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('message' in data) || (data.message is string && data.message.size() <= 500)) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
             (!('tournamentId' in data) || data.tournamentId == null || (data.tournamentId is string && data.tournamentId.size() <= 64)) &&
             (!('roomId' in data) || data.roomId == null || (data.roomId is string && data.roomId.size() <= 50)) &&
             (!('roomPassword' in data) || data.roomPassword == null || (data.roomPassword is string && data.roomPassword.size() <= 50)) &&
             (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128)) &&
             (!('timestamp' in data) || data.timestamp is number || data.timestamp is timestamp) &&
             (!('isRead' in data) || data.isRead is bool) &&
             (!('readByUsers' in data) || data.readByUsers is list) &&
             (!('clearedByUsers' in data) || data.clearedByUsers is list);
    }

    function isValidAppSettings(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 50)) &&
             (!('appName' in data) || (data.appName is string && data.appName.size() <= 50)) &&
             (!('announcementText' in data) || (data.announcementText is string && data.announcementText.size() <= 500)) &&
             (!('isMaintenance' in data) || data.isMaintenance is bool) &&
             (!('supportContact' in data) || (data.supportContact is string && data.supportContact.size() <= 100)) &&
             (!('minDeposit' in data) || data.minDeposit is number) &&
             (!('platformFeePercent' in data) || data.platformFeePercent is number) &&
             (!('rulesAndGuidelines' in data) || (data.rulesAndGuidelines is string && data.rulesAndGuidelines.size() <= 2000)) &&
             (!('latestAppVersion' in data) || (data.latestAppVersion is string && data.latestAppVersion.size() <= 30)) &&
             (!('updateReleaseNotes' in data) || (data.updateReleaseNotes is string && data.updateReleaseNotes.size() <= 2000));
    }

    function isValidSupportThread(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 100 &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 150)) &&
             (!('userFfIgn' in data) || (data.userFfIgn is string && data.userFfIgn.size() <= 60)) &&
             (!('userFfUid' in data) || (data.userFfUid is string && data.userFfUid.size() <= 60)) &&
             data.lastMessage is string && data.lastMessage.size() <= 1000 &&
             data.lastSenderId is string && data.lastSenderId.size() <= 128 &&
             (!('lastSenderIsAdmin' in data) || data.lastSenderIsAdmin is bool) &&
             data.lastMessageTimestamp is number &&
             (!('unreadByAdmin' in data) || (data.unreadByAdmin is number && data.unreadByAdmin >= 0)) &&
             (!('unreadByUser' in data) || (data.unreadByUser is number && data.unreadByUser >= 0)) &&
             data.status is string && data.status.size() <= 30 &&
             (!('hasImage' in data) || data.hasImage is bool) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidSupportMessage(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.threadUserId is string && data.threadUserId.size() >= 1 && data.threadUserId.size() <= 128 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.isAdminSender is bool &&
             data.messageText is string && data.messageText.size() <= 2000 &&
             (!('imageBase64' in data) || data.imageBase64 == null || (data.imageBase64 is string && data.imageBase64.size() <= 750000)) &&
             data.timestamp is number &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    match /tournaments/{tournamentId} {
      allow get, list: if true;
      allow create, update: if isValidId(tournamentId) && isValidTournament(incoming());
      allow delete: if isValidId(tournamentId);

      match /participants/{participantId} {
        allow get, list: if true;
        allow create, update: if isValidParticipant(incoming());
        allow delete: if true;
      }
    }

    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId);

      match /transactions/{transactionId} {
        allow get, list: if true;
        allow create, update: if isValidTransaction(incoming());
        allow delete: if true;
      }

      match /participations/{participantId} {
        allow get, list: if true;
        allow create, update: if isValidParticipant(incoming());
        allow delete: if true;
      }
    }

    match /participants/{participantId} {
      allow get, list: if true;
      allow create, update: if isValidParticipant(incoming());
      allow delete: if true;
    }

    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create, update: if isValidTransaction(incoming());
      allow delete: if true;
    }

    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create, update: if isValidNotification(incoming());
      allow delete: if true;
    }

    match /bonus_claims/{userId} {
      allow get, list: if true;
      allow create: if isValidId(userId);
      allow update, delete: if false; // Cryptographically immutable
    }

    match /device_bonus_claims/{deviceId} {
      allow get, list: if true;
      allow create: if isValidId(deviceId);
      allow update, delete: if false; // Cryptographically immutable
    }

    match /app_settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidAppSettings(incoming());
      allow delete: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow get, list: if true;
      allow create, update: if isValidId(withdrawalId);
      allow delete: if isValidId(withdrawalId);
    }

    match /support_chats/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && incoming().userId == userId && isValidSupportThread(incoming());
      allow delete: if isValidId(userId);

      match /messages/{messageId} {
        allow get, list: if true;
        allow create, update: if isValidId(userId) && isValidId(messageId) && incoming().threadUserId == userId && isValidSupportMessage(incoming());
        allow delete: if isValidId(userId) && isValidId(messageId);
      }
    }

    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }
  }
}
